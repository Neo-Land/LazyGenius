ANTHROPIC_API_KEY=sk-ant-...
# One model per step (docs/BUILD_PLAN.md, Model routing)
MODEL_WRITER=claude-sonnet-5-5
MODEL_ASK=claude-haiku-5-5
MODEL_JUDGE=claude-haiku-5-5
HARNESS_MAX_REVISIONS=2
HARNESS_USE_JUDGE=true
HARNESS_DATA_DIR=data
# true = no API key and no AI: summaries and answers just quote slides
HARNESS_OFFLINE=false

# Public demo only, see docs/DEPLOYMENT.md
HARNESS_DEMO=false
HARNESS_DEMO_ASKS_PER_MINUTE=5
HARNESS_DEMO_ASKS_PER_DAY=100
HARNESS_CORS_ORIGINS=http://localhost:3000

# Optional: Canvas sync (Account -> Settings -> New Access Token)
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=
# Optional: courses to skip, and friendlier names. Separate entries with ;
CANVAS_IGNORE_COURSES=
CANVAS_COURSE_NAMES=
